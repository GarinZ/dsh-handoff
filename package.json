{
  "name": "@garinz/dsh-handoff",
  "version": "0.2.0",
  "description": "Model-facing handoff for DeepSeek Harness: hand this session off to a session inside another workspace, with two history policies — full copy (fork the complete event history) or summary only (start a blank session from the written brief). dsh-handoff：把当前会话交接到另一个工作区的新会话里，可选「完整复制历史」或「只写总结不复制历史」；由 Agent 在对话中自行调用。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "handoff",
    "session",
    "workspace",
    "fork",
    "context",
    "交接",
    "工作区",
    "会话复制"
  ],
  "author": "garin",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GarinZ/dsh-handoff.git"
  },
  "homepage": "https://github.com/GarinZ/dsh-handoff#readme",
  "bugs": {
    "url": "https://github.com/GarinZ/dsh-handoff/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
